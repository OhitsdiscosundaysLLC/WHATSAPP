# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER put real secrets in source code.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Port the internal HTTP server (health checks, future dashboard API) listens on
PORT=3000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase (Phase 3+)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Service role key (server-side only — has full DB access, bypasses RLS).
# Never expose this to a client/browser/dashboard frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# OpenAI (Phase 6+)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Default model used for AI-assisted classification/replies
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Bot ownership / authorization
# ---------------------------------------------------------------------------
# Comma-separated list of E.164 phone numbers (no "+", digits only, WhatsApp
# JID local part) that are allowed to issue owner-level commands to the bot
# (e.g. "2348012345678,15551234567").
OWNER_WHATSAPP_NUMBERS=

# Comma-separated list of additional numbers granted admin-level (not owner-level)
# bot commands. Optional.
ADMIN_WHATSAPP_NUMBERS=

# ---------------------------------------------------------------------------
# WhatsApp connection (Phase 2+)
# ---------------------------------------------------------------------------
# Set to "false" to disable WhatsApp connectivity entirely (HTTP server
# still runs). Defaults to true.
WHATSAPP_ENABLED=true

# Local directory used to cache multi-device auth credentials between
# restarts during development (see docs/DECISIONS.md ADR-006). In production
# this is NOT durable — Render's filesystem is ephemeral across
# deploys/restarts, so a persistent auth provider is required there.
WHATSAPP_AUTH_DIR=./auth

# Reconnect backoff bounds (milliseconds) for transient disconnects.
WHATSAPP_RECONNECT_BASE_MS=2000
WHATSAPP_RECONNECT_MAX_MS=60000

# ---------------------------------------------------------------------------
# Deployment metadata (optional, used in logs/health reporting)
# ---------------------------------------------------------------------------
APP_VERSION=
